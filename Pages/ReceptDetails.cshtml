@page "{id:int}"
@model MealMatch.Pages.ReceptDetailsModel
@{
    ViewData["Title"] = "Recept";
}

<div class="recepten-pagina">

    @* ===== KNOPPEN BOVENAAN ===== *@
    @* Terug-link geeft PlanDatum mee, zodat je in de kies-modus blijft *@
    <a asp-page="/Recepten"
       asp-route-PlanDatum="@Model.PlanDatum?.ToString("yyyy-MM-dd")"
       class="btn-toevoegen">← Terug naar recepten</a>

    @if (Model.Recept != null)
    {
        @* Kies-modus: recept direct inplannen *@
        @if (Model.PlanDatum != null)
        {
            <form method="post"
                  asp-page="/Recepten"
                  asp-page-handler="Kies"
                  asp-route-id="@Model.Recept.Id"
                  asp-route-PlanDatum="@Model.PlanDatum.Value.ToString("yyyy-MM-dd")"
                  style="display:inline">
                <button type="submit" class="btn-kies">Kies dit recept</button>
            </form>
        }
        @* Normale modus: recept bewerken *@
        else
        {
            <a asp-page="/ReceptToevoegen" asp-route-id="@Model.Recept.Id" class="btn-toevoegen">Bewerken</a>
        }
    }

    @if (Model.Recept == null)
    {
        <p class="detail-melding">Dit recept bestaat niet (meer).</p>
    }
    else
    {
        <div class="recept-detail">

            @if (Model.Recept.FotoPad != null)
            {
                <img src="@Model.Recept.FotoPad" alt="Foto van @Model.Recept.Naam" class="detail-foto">
            }

            <h1>@Model.Recept.Naam</h1>
            <p class="detail-info">
                @Model.Recept.BereidingstijdMinuten minuten · voor @Model.Recept.Personen personen
            </p>

            <h2>Ingrediënten</h2>
            <ul>
                @foreach (MealMatch.Models.ReceptIngredient ri in Model.Recept.ReceptIngredienten)
                {
                    <li>@ri.Hoeveelheid @ri.Ingredient.Naam</li>
                }
            </ul>

            <h2>Bereidingswijze</h2>
            <p class="detail-bereiding">@Model.Recept.Bereidingswijze</p>

            @if (!string.IsNullOrWhiteSpace(Model.Recept.Opmerking))
            {
                <h2>Opmerking</h2>
                <p>@Model.Recept.Opmerking</p>
            }

        </div>
    }

</div>