@page "{id:int?}"
@model MealMatch.Pages.ReceptToevoegenModel
@{
    bool isBewerken = Model.Recept.Id != 0;
    ViewData["Title"] = isBewerken ? "Recept bewerken" : "Recept toevoegen";
}

<div class="recept-toevoegen-pagina">

    <div class="recept-toevoegen-header">
        <div>
            <p class="kleine-titel">Mijn recepten</p>
            <h1>@(isBewerken ? "Recept bewerken" : "Nieuw recept toevoegen")</h1>
            <p>@(isBewerken ? "Pas de gegevens van je recept aan." : "Voeg een nieuw recept toe aan je recepten.")</p>
        </div>
    </div>

    <form method="post" class="recept-formulier" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>
        <p class="verplicht-uitleg">Alle velden met een <span class="verplicht">*</span> zijn verplicht.</p>
        <input asp-for="Recept.Id" type="hidden">
        <input asp-for="Recept.FotoPad" type="hidden">

        <!-- Foto -->
        <div class="recept-foto">

            <div class="foto-titel">
                <i class="bi bi-image"></i>
                <h2>Foto</h2>
            </div>

            <div class="foto-upload">
                @if (Model.Recept.FotoPad != null)
                {
                    <img src="@Model.Recept.FotoPad" alt="Huidige foto" class="kaart-foto">
                }
                <p id="foto-tekst">Voeg een foto van je gerecht toe.</p>

                    <label asp-for="Foto" class="btn-foto">+ Foto kiezen</label>
                    <small class="foto-eisen">Toegestaan: .jpg, .jpeg of .png. Maximaal 5 MB.</small>
                    <input asp-for="Foto" type="file" accept=".jpg,.jpeg,.png" hidden>
            </div>

        </div>


        <!-- Basisinformatie -->
        <details class="formulier-sectie" open>

            <summary>

                <div class="sectie-titel">
                    <i class="bi bi-file-earmark-text"></i>
                    <h2>Basisinformatie</h2>
                </div>

                <span class="pijl">⌄</span>

            </summary>

            <div class="formulier-veld">
                <label asp-for="Recept.Naam">Naam van het recept <span class="verplicht">*</span></label>

                <input asp-for="Recept.Naam"
                       type="text"
                       placeholder="Bijvoorbeeld: Pasta pesto">
                <span asp-validation-for="Recept.Naam" class="text-danger"></span>
            </div>

            <div class="formulier-rij">

                <div class="formulier-veld">
                    <label asp-for="Recept.BereidingstijdMinuten">Bereidingstijd in minuten <span class="verplicht">*</span></label>

                    <input asp-for="Recept.BereidingstijdMinuten"
                           type="number"
                           min="1"
                           placeholder="30"
                           onfocus="this.select()">

                    <small>Vul de bereidingstijd in minuten in.</small>
                </div>

                <div class="formulier-veld">
                    <label asp-for="Recept.Personen">Aantal personen <span class="verplicht">*</span></label>

                    <input asp-for="Recept.Personen"
                           type="number"
                           min="1"
                           placeholder="2"
                           onfocus="this.select()">
                </div>

            </div>

        </details>


        <!-- Ingrediënten -->
        <details class="formulier-sectie">

            <summary>

                <div class="sectie-titel">
                    <i class="bi bi-basket-fill"></i>
                    <h2>Ingrediënten <span class="verplicht">*</span></h2>
                </div>

                <span class="pijl">⌄</span>

            </summary>

            <small class="ingredient-uitleg">Voeg minimaal één ingrediënt toe. Vul bij elk ingrediënt de naam en de hoeveelheid in.</small>
            <div id="ingredienten-container">

                @for (int i = 0; i < Model.ReceptIngredienten.Count; i++)
                {
                    <div class="ingredient-rij">

                        <input asp-for="ReceptIngredienten[i].Ingredient.Naam"
                               type="text"
                               placeholder="Bijvoorbeeld: kipfilet">

                        <input asp-for="ReceptIngredienten[i].Hoeveelheid"
                               type="text"
                               placeholder="Hoeveelheid">

                        <button type="button" class="btn-verwijder">
                            Verwijderen
                        </button>

                    </div>
                }

            </div>

            <button type="button" id="btn-ingredient" class="btn-ingredient">
                + Ingrediënt toevoegen
            </button>

        </details>


        <!-- Bereidingswijze -->
        <details class="formulier-sectie">

            <summary>

                <div class="sectie-titel">
                    <i class="bi bi-list-task"></i>
                    <h2>Bereidingswijze</h2>
                </div>

                <span class="pijl">⌄</span>

            </summary>

            <div class="formulier-veld">

                <label asp-for="Recept.Bereidingswijze">
                    Bereidingswijze <span class="verplicht">*</span>
                </label>

                <textarea asp-for="Recept.Bereidingswijze"
                          rows="6"
                          placeholder="Beschrijf hier stap voor stap hoe je het gerecht maakt."></textarea>

            </div>

        </details>


        <!-- Extra informatie -->
        <details class="formulier-sectie">

            <summary>

                <div class="sectie-titel">
                    <i class="bi bi-info-circle"></i>
                    <h2>Extra informatie</h2>
                </div>

                <span class="pijl">⌄</span>

            </summary>

            <div class="formulier-veld">

                <label asp-for="Recept.Opmerking">
                    Opmerking
                </label>

                <textarea asp-for="Recept.Opmerking"
                          rows="4"
                          placeholder="Bijvoorbeeld: geschikt voor mealprep"></textarea>

            </div>

        </details>


        <!-- Acties -->
                <!-- Acties -->
        <div class="formulier-acties">

            @if (isBewerken)
            {
                <a asp-page="/ReceptDetails" asp-route-id="@Model.Recept.Id" class="btn-annuleren">Annuleren</a>
            }
            else
            {
                <a href="/Recepten" class="btn-annuleren">Annuleren</a>
            }

            <button type="submit" class="btn-opslaan">
                Recept opslaan
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <script src="~/js/ReceptToevoegen.js" asp-append-version="true"></script>
}
