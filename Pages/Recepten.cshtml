@page
@model MealMatch.Pages.ReceptenModel
@{
    ViewData["Title"] = "Recepten";
}

<div class="recepten-pagina">

    <div class="recepten-header">
        <div>
            <p class="kleine-titel">Mijn recepten</p>
            <h1>Recepten</h1>
            <p>Bekijk en beheer je recepten.</p>
        </div>

        <a href="/ReceptToevoegen" class="btn-toevoegen">
            + Recept toevoegen
        </a>
    </div>

    @foreach (MealMatch.Models.Recept recept in Model.Recepten)
        {
            <div class="recept-kaart">
                <h2>@recept.Naam</h2>
                <p>@recept.BereidingstijdMinuten min</p>
                <p>Voor @recept.Personen personen</p>
            </div>
        }

</div>