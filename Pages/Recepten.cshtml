@page
@model MealMatch.Pages.ReceptenModel
@{
    ViewData["Title"] = "Recepten";
}

<div class="recepten-pagina">

    <div class="recepten-header">
        <div>
            <p class="kleine-titel">Mijn recepten</p>
            <h1>Recepten</h1>
            <p>Bekijk en beheer je recepten.</p>
        </div>

        <a href="/ReceptToevoegen" class="btn-toevoegen">
            + Recept toevoegen
        </a>
    </div>

    <div class="recepten-lijst">

        <div class="recept-kaart">
            <h2>Kip met groenten</h2>

            <p>25 min</p>

            <p>Voor 2 personen</p>

            <button type="button">Verwijderen</button>
        </div>

        <div class="recept-kaart">
            <h2>Zalm met broccoli</h2>

            <p>30 min</p>

            <p>Voor 2 personen</p>

            <button type="button">Verwijderen</button>
        </div>

        <div class="recept-kaart">
            <h2>Omelet met kaas</h2>

            <p>15 min</p>

            <p>Voor 1 persoon</p>

            <button type="button">Verwijderen</button>
        </div>

    </div>

</div>
```
