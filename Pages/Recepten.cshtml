@page
@model MealMatch.Pages.ReceptenModel
@{
    ViewData["Title"] = "Recepten";
}

<div class="recepten-pagina recepten-overzicht">

    @* ===== NAVIGATIEBALK: alleen op de receptenpagina ===== *@
    <header class="topbalk">

        <nav class="topnav">

            <a href="/" class="topnav-link" aria-label="Homepage">
                <i class="bi bi-house"></i>
            </a>

            <div class="topnav-dropdown">
                <a href="/Recepten" class="topnav-link">
                    Recepten <i class="bi bi-chevron-down"></i>
                </a>
                <div class="recepten-dropdown">
                    <a href="/Recepten">Alle recepten</a>
                    <a href="/ReceptToevoegen">Recept toevoegen</a>
                </div>
            </div>

            <a href="/Recepten?Weekmenu=open" class="topnav-link">Weekmenu</a>

            <button type="button" id="zoekknop" class="topnav-zoekknop" aria-label="Zoeken">
                <i class="bi bi-search"></i>
            </button>

        </nav>

        <form method="get" action="/Recepten" id="zoekveld" class="topnav-zoekveld" hidden>
            <label for="nav-zoektekst" class="visueel-verborgen">Zoek op receptnaam</label>
            <input type="text" id="nav-zoektekst" name="Zoektekst" value="@Model.Zoektekst" placeholder="Zoek op receptnaam">
            <button type="submit" class="btn-toevoegen">Zoeken</button>
        </form>

    </header>

    @* Titel alleen voor schermlezers, niet zichtbaar op het scherm *@
    <h1 class="visueel-verborgen">Recepten</h1>

    @* ===== KIES-MELDING: alleen zichtbaar als je via het plusje op de homepage komt ===== *@
    @if (Model.PlanDatum != null)
    {
        <div class="kies-melding">
            Kies een recept voor
            <strong>@Model.PlanDatum.Value.ToString("dddd d MMMM", new System.Globalization.CultureInfo("nl-NL"))</strong>
            <a asp-page="/Index">Annuleren</a>
        </div>
    }

    @* ===== ZOEK-MELDING: laat zien waarop je gezocht hebt ===== *@
    @if (!string.IsNullOrWhiteSpace(Model.Zoektekst))
    {
        <p class="zoek-melding">
            Zoekresultaten voor "<strong>@Model.Zoektekst</strong>"
            <a asp-page="/Recepten" asp-route-Weergave="@Model.Weergave">Wis zoekopdracht</a>
        </p>
    }

    @* ===== TOOLBAR: filter en weergave-knoppen op één regel ===== *@
    <div class="recepten-toolbar">

        @* FILTER: recepten filteren op bereidingstijd *@
        @* De hidden velden zorgen dat Weergave, Sortering, Zoektekst en PlanDatum niet kwijtraken bij het filteren *@
        <form method="get" class="filter-balk">
            <label asp-for="GekozenTijd" class="visueel-verborgen">Bereidingstijd</label>
            <select asp-for="GekozenTijd">
                <option value="">Alle bereidingstijden</option>
                @foreach (int tijd in Model.Bereidingstijden)
                {
                    <option value="@tijd">@tijd minuten</option>
                }
            </select>
            <input type="hidden" name="Weergave" value="@Model.Weergave">
            <input type="hidden" name="Sortering" value="@Model.Sortering">
            <input type="hidden" name="Zoektekst" value="@Model.Zoektekst">
            <input type="hidden" name="PlanDatum" value="@Model.PlanDatum?.ToString("yyyy-MM-dd")">
            <button type="submit" class="btn-toevoegen">Filter</button>
        </form>

        @* WEERGAVE-KNOPPEN: wisselen tussen kaartjes en lijst *@
        <div class="weergave-knoppen">
            <a asp-page="/Recepten"
               asp-route-Weergave="kaartjes"
               asp-route-GekozenTijd="@Model.GekozenTijd"
               asp-route-Zoektekst="@Model.Zoektekst"
               asp-route-Sortering="@Model.Sortering"
               asp-route-PlanDatum="@Model.PlanDatum?.ToString("yyyy-MM-dd")"
               class="weergave-knop @(Model.Weergave != "lijst" ? "actief" : "")">
                <i class="bi bi-grid"></i> Kaartjes
            </a>
            <a asp-page="/Recepten"
               asp-route-Weergave="lijst"
               asp-route-GekozenTijd="@Model.GekozenTijd"
               asp-route-Zoektekst="@Model.Zoektekst"
               asp-route-Sortering="@Model.Sortering"
               asp-route-PlanDatum="@Model.PlanDatum?.ToString("yyyy-MM-dd")"
               class="weergave-knop @(Model.Weergave == "lijst" ? "actief" : "")">
                <i class="bi bi-list-ul"></i> Lijst
            </a>
        </div>

    </div>

    @* ===== GEEN RECEPTEN: melding als de lijst leeg is ===== *@
    @if (Model.Recepten.Count == 0)
    {
        <p>Er zijn geen recepten gevonden.</p>
    }

    @* ===== LIJST-WEERGAVE: recepten in een tabel ===== *@
    else if (Model.Weergave == "lijst")
    {
        <table class="recepten-tabel">
            <thead>
                <tr>
                    <th>
                        <a asp-page="/Recepten"
                           asp-route-Weergave="lijst"
                           asp-route-GekozenTijd="@Model.GekozenTijd"
                           asp-route-Zoektekst="@Model.Zoektekst"
                           asp-route-PlanDatum="@Model.PlanDatum?.ToString("yyyy-MM-dd")"
                           asp-route-Sortering="@(Model.Sortering == "za" ? "az" : "za")">
                            Naam (@(Model.Sortering == "za" ? "Z-A" : "A-Z"))
                        </a>
                    </th>
                    <th>Bereidingstijd</th>
                    <th>Personen</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (MealMatch.Models.Recept recept in Model.Recepten)
                {
                    <tr>
                        <td><a asp-page="/ReceptDetails" asp-route-id="@recept.Id" asp-route-PlanDatum="@Model.PlanDatum?.ToString("yyyy-MM-dd")">@recept.Naam</a></td>
                        <td>@recept.BereidingstijdMinuten min</td>
                        <td>@recept.Personen</td>
                        <td>
                            @* Kies-modus: knop om dit recept in te plannen *@
                            @if (Model.PlanDatum != null)
                            {
                                <form method="post"
                                      asp-page-handler="Kies"
                                      asp-route-id="@recept.Id"
                                      asp-route-PlanDatum="@Model.PlanDatum.Value.ToString("yyyy-MM-dd")">
                                    <button type="submit" class="btn-kies">Kies dit recept</button>
                                </form>
                            }
                            @* Normale modus: knop om dit recept te verwijderen *@
                            else
                            {
                                <form method="post"
                                      asp-page-handler="Verwijder"
                                      asp-route-id="@recept.Id"
                                      asp-route-Weergave="@Model.Weergave"
                                      onsubmit="return confirm('Weet je zeker dat je dit recept wilt verwijderen?');">
                                    <button type="submit">Verwijderen</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ===== KAARTJES-WEERGAVE: recepten als kaartjes met foto ===== *@
    else
    {
        <div class="recepten-lijst">
            @foreach (MealMatch.Models.Recept recept in Model.Recepten)
            {
                <div class="recept-kaart">
                    <a asp-page="/ReceptDetails" asp-route-id="@recept.Id" class="kaart-link"
                       asp-route-PlanDatum="@Model.PlanDatum?.ToString("yyyy-MM-dd")">
                        @if (recept.FotoPad != null)
                        {
                            <img src="@recept.FotoPad" alt="Foto van @recept.Naam" class="kaart-foto">
                        }
                        else
                        {
                            <div class="kaart-foto geen-foto"><i class="bi bi-image"></i></div>
                        }
                        <h2>@recept.Naam</h2>
                    </a>
                    <p>@recept.BereidingstijdMinuten min</p>
                    <p>Voor @recept.Personen @(recept.Personen == 1 ? "persoon" : "personen")</p>

                    @* Kies-modus: knop om dit recept in te plannen *@
                    @if (Model.PlanDatum != null)
                    {
                        <form method="post"
                              asp-page-handler="Kies"
                              asp-route-id="@recept.Id"
                              asp-route-PlanDatum="@Model.PlanDatum.Value.ToString("yyyy-MM-dd")">
                            <button type="submit" class="btn-kies">Kies dit recept</button>
                        </form>
                    }
                    @* Normale modus: knop om dit recept te verwijderen *@
                    else
                    {
                        <form method="post"
                              asp-page-handler="Verwijder"
                              asp-route-id="@recept.Id"
                              asp-route-Weergave="@Model.Weergave"
                              onsubmit="return confirm('Weet je zeker dat je dit recept wilt verwijderen?');">
                            <button type="submit">Verwijderen</button>
                        </form>
                    }
                </div>
            }
        </div>
    }

</div>

@section Scripts {
    <script>
        // Vergrootglas: zoekveld tonen of verbergen
        const zoekknop = document.getElementById("zoekknop");
        const zoekveld = document.getElementById("zoekveld");

        zoekknop.addEventListener("click", function () {
            zoekveld.hidden = !zoekveld.hidden;

            if (!zoekveld.hidden) {
                document.getElementById("nav-zoektekst").focus();
            }
        });
    </script>
}
